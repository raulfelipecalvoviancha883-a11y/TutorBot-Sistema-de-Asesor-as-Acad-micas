      "parameters": {
        "jsCode": "const ahora = new Date();\nconst enUnaHora = new Date(ahora.getTime() + 60 * 60 * 1000);\n\nconst items = $input.all().map(i => i.json).filter(t => {\n  if (!['Asignada', 'Confirmada'].includes(t.estado)) return false;\n  if (String(t.recordatorio_enviado).toUpperCase() === 'TRUE') return false;\n  const fechaHora = new Date(`${t.fecha}T${t.hora}:00`);\n  return fechaHora >= ahora && fechaHora <= enUnaHora;\n});\n\nreturn items.map(t => ({ json: t }));\n"
      },
